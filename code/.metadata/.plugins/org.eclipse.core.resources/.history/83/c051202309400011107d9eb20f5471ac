/* main.c */

/******************** Library *********************/
#include "stm32f4xx_hal.h"
#include "main.h"

/******************** Prototype *******************/
void SystemClockConfig(void);
void UART2_Init(void);

/******************** Handle **********************/
UART_HandleTypeDef huart2;

/**************************************************
 * @fn       main
 * @brief
 */
int main(void)
{
	HAL_Init(); /* calls HAL_MspInit(); */
	SystemClockConfig();
	UART2_Init();

	return 0;
}

/**************************************************
 * @fn      SystemClockConfig
 * @brief
 */
void SystemClockConfig(void)
{

}

/**************************************************
 * @fn      UART2_Init
 * @brief
 */
void UART2_Init(void)
{
	huart2.Instance = USART2;
	huart2.Init.BaudRate = 115200;

}
